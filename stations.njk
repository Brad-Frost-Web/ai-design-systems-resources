---
layout: base.njk
permalink: /stations/
---
<ed-main>
	<ed-r-course-hero compact>
		<ed-heading tagName="h1">MULTI-POINT INSPECTION</ed-heading>
		<p style="font-size: 1.6rem; margin: 0.5rem 0 0;">Find resources by the design-system problem they solve</p>
	</ed-r-course-hero>

	<ed-layout-container class="ed-u-padding-top-xl">
		<p class="stations-intro">
			The <a href="https://github.com/Brad-Frost-Web/ai-design-systems-inspection-kit">Multi-Point Inspection</a>
			from the <a href="https://aianddesign.systems">AI &amp; Design Systems course</a> checks a design system across
			<strong>{{ stations.qualities.length }} qualities</strong> and <strong>{{ stations.stations.length }} stations</strong>.
			Set your check-engine lights in the sidebar to get a prioritized work order.
		</p>

		{% set taggedCount = 0 %}
		{% for r in resources %}{% if r.stations.length %}{% set taggedCount = taggedCount + 1 %}{% endif %}{% endfor %}
		<ed-alert variant="info" class="stations-sample-note">
			<strong>Sample stage:</strong> {{ taggedCount }} of {{ resources.length }} resources are classified so far.
			Recommendations draw only from the classified set for now.
		</ed-alert>

		<ed-layout variant="left-sidebar" gap="xl" class="stations-layout">
			{# ---------- Sidebar: sticky check-engine control ---------- #}
			<ed-layout-section behavior="sticky" top="1.5rem">
				<form class="diagnose-panel" id="diagnose" aria-labelledby="diagnose-h">
					<div class="diagnose-panel__head">
						<h2 class="diagnose-panel__title" id="diagnose-h">Check-engine lights</h2>
						<button type="button" class="diagnose__reset" id="diagnose-reset">Reset</button>
					</div>
					<p class="diagnose-panel__hint">Mark where your system needs work. We rank reds first.</p>
					<p class="diagnose-tally" id="diagnose-tally" aria-live="polite"></p>

					<div class="diagnose-rows">
						{% for station in stations.stations %}
						<fieldset class="diag-row" data-station="{{ station.slug }}">
							<legend class="diag-row__name">
								<span class="diag-row__num">{{ station.id }}</span>{{ station.name }}
							</legend>
							<div class="rating rating--compact" role="radiogroup" aria-label="{{ station.name }} status">
								<label class="rating__opt rating__opt--green" title="Green — healthy">
									<input type="radio" name="s-{{ station.slug }}" value="green"> <span>Green</span>
								</label>
								<label class="rating__opt rating__opt--yellow" title="Yellow — watch">
									<input type="radio" name="s-{{ station.slug }}" value="yellow"> <span>Yellow</span>
								</label>
								<label class="rating__opt rating__opt--red" title="Red — broken">
									<input type="radio" name="s-{{ station.slug }}" value="red"> <span>Red</span>
								</label>
							</div>
						</fieldset>
						{% endfor %}
					</div>
				</form>
			</ed-layout-section>

			{# ---------- Main column: work order + browse ---------- #}
			<ed-layout-section>
				<section class="work-order" id="work-order" aria-labelledby="work-order-h" hidden>
					<h2 class="work-order__title" id="work-order-h">Your work order</h2>
					<p class="work-order__lead" id="work-order-lead"></p>
					<div class="work-order__list" id="work-order-list"></div>
				</section>

				<h2 class="stations-browse-h">Browse every station</h2>
				{% for quality in stations.byQuality %}
				<section class="station-quality" aria-labelledby="quality-{{ quality.slug }}">
					<h3 class="station-quality__name" id="quality-{{ quality.slug }}">
						<span class="station-quality__num">Quality {{ quality.id }}</span>
						{{ quality.name }}
					</h3>
					<p class="station-quality__question">{{ quality.question }}</p>

					{% for station in quality.stations %}
					{% set matches = [] %}
					{% for r in resources %}
						{% if station.slug in r.stations %}{% set matches = (matches.push(r), matches) %}{% endif %}
					{% endfor %}

					<section class="station" id="station-{{ station.slug }}" aria-labelledby="station-{{ station.slug }}-h">
						<div class="station__head">
							<h4 class="station__name" id="station-{{ station.slug }}-h">
								<span class="station__num">Station {{ station.id }}</span>
								{{ station.name }}
							</h4>
							<ed-badge text="{{ matches.length }} resource{% if matches.length != 1 %}s{% endif %}"></ed-badge>
						</div>
						<p class="station__question">{{ station.question }}</p>

						{% if matches.length %}
						<ed-grid variant="2up">
							{% for resource in matches %}
							<ed-grid-item class="resource-grid-item">
								{% include "resource-card.njk" %}
							</ed-grid-item>
							{% endfor %}
						</ed-grid>
						{% else %}
						<p class="station__empty">No resources classified for this station yet.</p>
						{% endif %}
					</section>
					{% endfor %}
				</section>
				{% endfor %}
			</ed-layout-section>
		</ed-layout>
	</ed-layout-container>
</ed-main>

{# Data island: classified resources for the client-side recommender. #}
{%- set recData = [] -%}
{%- for r in resources -%}
	{%- if r.stations.length -%}
		{%- set _ = recData.push({ title: r.title, href: r.href, stations: r.stations, confidence: r.stationsConfidence, summary: r.slackSummary, sentiment: r.slackSentiment, slackUrl: r.slackMessageUrl }) -%}
	{%- endif -%}
{%- endfor -%}
<script type="application/json" id="resource-data">{{ recData | dump | safe }}</script>
<script type="application/json" id="station-meta">{{ stations.stations | dump | safe }}</script>
