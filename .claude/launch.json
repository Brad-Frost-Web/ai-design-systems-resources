{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "netlify",
      "runtimeExecutable": "netlify",
      "runtimeArgs": [
        "dev",
        "--no-open"
      ],
      "port": 8888,
      "autoPort": false
    }
  ]
}